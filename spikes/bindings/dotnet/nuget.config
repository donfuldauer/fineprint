<!-- FP-005 (#6) spike: the local feed dist/nuget holds the packed FinePrint.Spike.Interop. -->
<configuration>
  <packageSources>
    <clear />
    <add key="spike-local" value="../dist/nuget" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="spike-local">
      <package pattern="FinePrint.Spike.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
